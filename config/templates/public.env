## OTHER CONFIG ##
# server domain name:
HOSTNAME=localhost
# server port:
SERVER_PORT=4000
# address the server listens on. The default is all IPv4 addresses, with no IPv6. Use 127.0.0.1 to only accept connections from a reverse proxy on the same machine, or ::1 for the same over IPv6. Use :: for all IPv6 addresses: on Linux and macOS it also accepts IPv4, but on FreeBSD and OpenBSD it accepts IPv6 only. Hosts that only have IPv6 must set ::
# SERVER_IP=127.0.0.1
# port your visitors will access (typically 80 or 443, will be different than SERVER_PORT only if using a reverse proxy)
PUBLIC_PORT=4000

# uncomment in order to NOT automatically change the database schema when you upgrade the app
# DISABLE_DB_AUTOMIGRATION=true

# max file upload size (default is 20 MB)
# in megabytes
UPLOAD_LIMIT=20
UPLOAD_LIMIT_IMAGES=5
UPLOAD_LIMIT_VIDEOS=20

# Use bandit (default), cowboy, or cowboy_socket (cowboy on a unix socket) as webserver? cowboy and cowboy_socket also have to be set when building, otherwise cowboy isn't compiled in
PLUG_SERVER=bandit

# Enables other websites/apps to sign in using accounts on this Bonfire instance
ENABLE_SSO_PROVIDER=true

# Requests to private, loopback or local network addresses are refused (to prevent SSRF). To federate with another instance on this machine or your local network (e.g. in Docker), list its host:port, comma-separated. Not needed for TEST_INSTANCE=yes, which allows its two local instances itself.
# SSRF_ALLOW_HOSTS=localhost:4002

# uncomment to allow letters from any script in usernames on this instance (e.g. josé or 你好), not only a-z, 0-9 and _. Some other fediverse software can't yet find or mention such users.
# UNICODE_USERNAMES=true

# ====================================
# You should not have to edit any of the following ones:
POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_DB=bonfire_db
# change to true only after initial migrations were run
DB_MIGRATE_INDEXES_CONCURRENTLY=false

LANG=en_US.UTF-8 
LANGUAGE=en_US.UTF-8
ACME_AGREE=true
REPLACE_OS_VARS=true

LIVEVIEW_ENABLED=true
WITH_API_GRAPHQL=1
WITH_LV_NATIVE=0
WITH_IMAGE_VIX=0 
WITH_AI=0
SHOW_DEBUG_IN_DEV=true
RUSTLER_BUILD_ALL=false
DECENT_BUILD=0
