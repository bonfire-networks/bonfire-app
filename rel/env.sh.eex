#!/bin/sh
# Release environment setup, sourced by the boot script before the BEAM starts.
# https://hexdocs.pm/mix/Mix.Tasks.Release.html#module-environment-variables

# Load the Erlang distribution cookie from a file (Docker secrets / systemd LoadCredential /
# k8s mounted secret) instead of exposing it as a plain env var. See bonfire-app#1663.
# Runs before `erl`, so it's the only place we can set the cookie from a file (runtime.exs is
# too late). The fully-airtight alternative is to mount $HOME/.erlang.cookie (mode 400) and set
# no RELEASE_COOKIE at all, which the BEAM reads natively.
if [ -z "$RELEASE_COOKIE" ] && [ -n "$RELEASE_COOKIE_FILE" ] && [ -r "$RELEASE_COOKIE_FILE" ]; then
  export RELEASE_COOKIE="$(tr -d '\r\n' < "$RELEASE_COOKIE_FILE")"
fi

# Every connection is a file descriptor: each request Bandit accepts, each LiveView websocket, each
# outbound federation request, each DB connection. Docker gives containers a low *soft* limit (1024 on
# many hosts) next to a much higher hard limit, and the BEAM only ever uses the soft one, so a busy
# instance runs out of descriptors and stops accepting connections:
#   ** (Bandit.TransportError) Unrecoverable error: emfile
# Raising the soft limit up to the hard limit needs no privileges. Capped rather than maxed out because
# ERTS sizes some of its I/O bookkeeping from this at boot, so an `unlimited` hard limit would have it
# reserve absurd amounts. Override with NOFILE_LIMIT, or set SKIP_ULIMIT=1 to leave the limit alone.
if [ -z "$SKIP_ULIMIT" ]; then
  nofile="${NOFILE_LIMIT:-65536}"
  soft_nofile="$(ulimit -Sn 2>/dev/null)"
  hard_nofile="$(ulimit -Hn 2>/dev/null)"

  # never ask for more than the hard limit (that would need privileges we don't have)
  case "$hard_nofile" in
    # unknown, unlimited or otherwise not a number: ask for what we want and let it fail if it must
    ''|*[!0-9]*) ;;
    *) if [ "$hard_nofile" -lt "$nofile" ]; then nofile="$hard_nofile"; fi ;;
  esac

  # only ever RAISE: a host generous enough to hand us a bigger soft limit already keeps it
  case "$soft_nofile" in
    ''|*[!0-9]*) nofile="" ;;
    *) if [ "$soft_nofile" -ge "$nofile" ]; then nofile=""; fi ;;
  esac

  if [ -n "$nofile" ]; then
    if ulimit -Sn "$nofile" 2>/dev/null; then
      :
    else
      echo "WARNING: could not raise the open file limit to $nofile (it is $(ulimit -Sn)). Under load the server may stop accepting connections with an emfile error."
    fi
  fi
fi

# # Set the release to load code on demand (interactive) instead of preloading (embedded).
# export RELEASE_MODE=interactive

# # Set the release to work across nodes.
# export RELEASE_DISTRIBUTION=name
# export RELEASE_NODE=<%= @release.name %>@127.0.0.1
